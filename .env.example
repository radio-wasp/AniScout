# Host port to expose AniScout Web UI
PORT=3456

# Request Routing Mode: "seerr" (Request via Overseerr/Jellyseerr), "arr" (Direct Sonarr/Radarr), or "both"
DEFAULT_MODE=both

# -----------------------------------------------------------------------------
# Seerr (Overseerr / Jellyseerr) Integration
# -----------------------------------------------------------------------------
SEERR_URL=http://localhost:5055
SEERR_API_KEY=your_seerr_api_key_here

# -----------------------------------------------------------------------------
# Sonarr Integration (Anime TV Series, OVAs, ONAs)
# -----------------------------------------------------------------------------
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here
SONARR_QUALITY_PROFILE_ID=1
SONARR_ROOT_FOLDER=/data/media/anime
SONARR_ANIME_SERIES_TYPE=anime
SONARR_SEARCH_ON_ADD=true

# -----------------------------------------------------------------------------
# Radarr Integration (Anime Movies)
# -----------------------------------------------------------------------------
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_QUALITY_PROFILE_ID=1
RADARR_ROOT_FOLDER=/data/media/anime-movies
RADARR_SEARCH_ON_ADD=true
